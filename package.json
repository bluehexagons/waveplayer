{
  "name": "waveplayer",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A modern, dependency-light waveform audio player demo.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  }
}
